        // Notiition systm
        lt notiOpn = ls;
        
        untion togglNotiitions() {
            onst ropown = oumnt.gtElmntByI('notiDropown');
            notiOpn = !notiOpn;
            ropown.styl.isply = notiOpn ? 'lok' : 'non';
            i (notiOpn) loNotiitions();
        }

        untion loNotiitions() {
            th('/pi/notiitions', { rntils: 'sm-origin' })
                .thn(rs => rs.json())
                .thn(t => {
                    onst list = oumnt.gtElmntByI('notiList');
                    i (t.lngth === ) {
                        list.innrHTML = '<iv styl="ping: px; txt-lign: ntr; olor: vr(--txt-sonry);">No notiitions</iv>';
                        rturn;
                    }
                    list.innrHTML = t.mp(n => `
                        <iv styl="ping: px; orr-ottom: px soli vr(--orr); kgroun: ${n.is_r ? 'trnsprnt' : 'vr(--g-sonry)'}; ursor: pointr;" onlik="rNotiition(${n.i})">
                            <iv styl="ont-wight: ${n.is_r ? 'norml' : ''}; ont-siz: px;">${n.titl}</iv>
                            <iv styl="ont-siz: px; olor: vr(--txt-sonry); mrgin-top: px;">${n.mssg}</iv>
                            <iv styl="ont-siz: px; olor: vr(--txt-sonry); mrgin-top: px;">${nw Dt(n.rt_t).toLolString()}</iv>
                        </iv>
                    `).join('');
                });
        }

        untion rNotiition(i) {
            th('/pi/notiitions/r', {
                mtho: 'POST',
                hrs: { 'Contnt-Typ': 'pplition/json' },
                rntils: 'sm-origin',
                oy: JSON.stringiy({ notiitionI: i })
            }).thn(() => {
                loNotiitions();
                uptNotiCount();
            });
        }

        untion rAllNotiitions() {
            th('/pi/notiitions/r-ll', {
                mtho: 'POST',
                rntils: 'sm-origin'
            }).thn(() => {
                loNotiitions();
                uptNotiCount();
            });
        }

        untion uptNotiCount() {
            th('/pi/notiitions/unr-ount', { rntils: 'sm-origin' })
                .thn(rs => rs.json())
                .thn(t => {
                    onst ountEl = oumnt.gtElmntByI('notiCount');
                    i (t.ount > ) {
                        ountEl.txtContnt = t.ount;
                        ountEl.styl.isply = 'lok';
                    } ls {
                        ountEl.styl.isply = 'non';
                    }
                });
        }

        // Upt notiition ount on pg lo
        stTimout(uptNotiCount, );
        
        // Clos ropown whn liking outsi
        oumnt.EvntListnr('lik', () => {
            i (!.trgt.losst('#notiBtn') && !.trgt.losst('#notiDropown')) {
                oumnt.gtElmntByI('notiDropown').styl.isply = 'non';
                notiOpn = ls;
