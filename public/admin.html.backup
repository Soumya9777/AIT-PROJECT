    <sript>
        (syn () => {
            onst rs = wit th('/pi/sssion', { rntils: 'sm-origin' });
            onst t = wit rs.json();
            i (!t.rol || t.rol !== 'min') lotion.hr = '/';
            
            i (t.nm) {
                oumnt.gtElmntByI('wlomHr').innrHTML = `
