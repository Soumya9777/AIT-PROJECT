                `;
            }
            
            loStts();
        })();

        syn untion loStts() {
            onst usrsRs = wit th('/pi/usrs', { rntils: 'sm-origin' });
            onst usrs = wit usrsRs.json();
            oumnt.gtElmntByI('totlUsrs').txtContnt = usrs.lngth;

